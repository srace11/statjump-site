---
// App Store and Google Play badges in the classic black style. A badge with a link is a normal link;
// one without (the app isn't in that store yet) is shown grayed out and not clickable, with "Coming soon"
// under the row. Set the links in app.config.ts (`stores`) once the app is live and they switch over.
// These are drawn here, not Apple's or Google's official artwork: swap that in for launch if you like
// (both companies ask that their official badges only link to a live listing and aren't recolored).
interface Props {
  appStore?: string;
  googlePlay?: string;
}
const { appStore = '', googlePlay = '' } = Astro.props;
const stores = [
  { id: 'apple', href: appStore, small: 'Download on the', big: 'App Store', name: 'App Store' },
  { id: 'google', href: googlePlay, small: 'Get it on', big: 'Google Play', name: 'Google Play' },
];
const anySoon = stores.some((s) => !s.href);
---
<div class="stores">
  <div class="row">
    {stores.map((s) => {
      const Tag = s.href ? 'a' : 'span';
      return (
        <Tag class:list={['store', { soon: !s.href }]} href={s.href || undefined} rel={s.href ? 'noopener' : undefined}>
          {s.id === 'apple' ? (
            <svg class="logo" viewBox="0 0 24 24" aria-hidden="true"><path fill="#fff" d="M16.37 12.6c-.02-2.2 1.8-3.26 1.88-3.31-1.02-1.5-2.62-1.7-3.19-1.72-1.36-.14-2.65.8-3.34.8-.69 0-1.75-.78-2.88-.76-1.48.02-2.85.86-3.61 2.19-1.54 2.67-.39 6.62 1.11 8.78.73 1.06 1.6 2.25 2.75 2.2 1.1-.04 1.52-.71 2.85-.71 1.33 0 1.71.71 2.88.69 1.19-.02 1.94-1.08 2.66-2.14.84-1.23 1.19-2.42 1.2-2.48-.03-.01-2.3-.88-2.31-3.5zM14.2 6.15c.61-.74 1.02-1.76.91-2.78-.88.04-1.94.59-2.57 1.32-.56.65-1.06 1.69-.93 2.69.98.08 1.98-.5 2.59-1.23z"/></svg>
          ) : (
            <svg class="logo" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="#00d7fe" d="M3.5 2.1c-.3.3-.5.8-.5 1.4v17c0 .6.2 1.1.5 1.4l9.4-9.9z"/>
              <path fill="#ffce00" d="M16.1 15.2 12.9 12l3.2-3.2 3.7 2.1c1.1.6 1.1 1.6 0 2.2z"/>
              <path fill="#ff3a44" d="M16.1 15.2 12.9 12l-9.4 9.9c.4.4.9.4 1.6.1z"/>
              <path fill="#00f076" d="M16.1 8.8 5.1 2c-.7-.4-1.3-.3-1.6.1l9.4 9.9z"/>
            </svg>
          )}
          <span class="text">
            <span class="small">{s.small}</span>
            <span class="big">{s.big}</span>
          </span>
          {!s.href && <span class="sr-only"> (coming soon)</span>}
        </Tag>
      );
    })}
  </div>
  {anySoon && <p class="caption" aria-hidden="true">Coming soon</p>}
</div>

<style>
  .stores { display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .row { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
  .store {
    display: inline-flex; align-items: center; gap: 8px; height: 48px; padding: 0 16px 0 12px;
    background: #000; color: #fff; border: 1px solid #a6a6a6; border-radius: 10px; text-decoration: none;
  }
  a.store:focus-visible { outline: 3px solid var(--volt); outline-offset: 3px; }
  .logo { width: 26px; height: 26px; flex: none; }
  .text { display: flex; flex-direction: column; align-items: flex-start; line-height: 1.05; text-align: left; }
  .small { font-size: .68rem; letter-spacing: .02em; }
  .big { font-size: 1.15rem; font-weight: 600; letter-spacing: -.01em; }
  /* Not in that store yet: grayed out a little, and not a link. */
  .store.soon { opacity: .5; filter: grayscale(1); cursor: default; }
  .caption { margin: 0; font-size: .8rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: #a9b6cc; }
</style>
