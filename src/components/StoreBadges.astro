---
// Simple text badges. If you want Apple's and Google's official badge artwork,
// download it from their marketing guidelines pages and swap it in here.
interface Props {
  appStore?: string;
  googlePlay?: string;
}
const { appStore = '', googlePlay = '' } = Astro.props;
const none = !appStore && !googlePlay;
---
<div class="badges">
  {appStore && (
    <a class="badge" href={appStore} rel="noopener">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16.37 12.6c-.02-2.2 1.8-3.26 1.88-3.31-1.02-1.5-2.62-1.7-3.19-1.72-1.36-.14-2.65.8-3.34.8-.69 0-1.75-.78-2.88-.76-1.48.02-2.85.86-3.61 2.19-1.54 2.67-.39 6.62 1.11 8.78.73 1.06 1.6 2.25 2.75 2.2 1.1-.04 1.52-.71 2.85-.71 1.33 0 1.71.71 2.88.69 1.19-.02 1.94-1.08 2.66-2.14.84-1.23 1.19-2.42 1.2-2.48-.03-.01-2.3-.88-2.31-3.5zM14.2 6.15c.61-.74 1.02-1.76.91-2.78-.88.04-1.94.59-2.57 1.32-.56.65-1.06 1.69-.93 2.69.98.08 1.98-.5 2.59-1.23z"/></svg>
      <span>Download on the<b>App Store</b></span>
    </a>
  )}
  {googlePlay && (
    <a class="badge" href={googlePlay} rel="noopener">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.2 2.3c-.2.2-.3.6-.3 1v17.4c0 .4.1.8.3 1l9.7-9.7L4.2 2.3zm10.8 10.8 2.9 2.9-11.4 6.5 8.5-9.4zm0-2.2L6.5 1.5l11.4 6.5-2.9 2.9zm4.1-2.2 3 1.7c.9.5.9 1.3 0 1.8l-3 1.7-3.1-3.1 3.1-2.1z"/></svg>
      <span>Get it on<b>Google Play</b></span>
    </a>
  )}
  {none && <span class="badge soon">Coming soon to iOS and Android</span>}
</div>
