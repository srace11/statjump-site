---
import Base from '../layouts/Base.astro';
import StoreBadges from '../components/StoreBadges.astro';
import { app } from '../app.config';
---
<Base>
  <section class="hero">
    <div class="wrap hero-in">
      <h1>
        <img src="/brand/stat-jump-lockup-reverse.svg" alt={`${app.name} Volleyball`} width="477" height="93" />
      </h1>
      <p class="slogan">{app.tagline}</p>
      <p class="lead">{app.description}</p>
      <StoreBadges appStore={app.stores.appStore} googlePlay={app.stores.googlePlay} />
    </div>
  </section>

  <section class="wrap features" aria-label="How it works">
    {app.features.map((f) => (
      <article class="feature">
        <div class="feature-num" aria-hidden="true">{f.icon}</div>
        <h2>{f.title}</h2>
        <p>{f.body}</p>
      </article>
    ))}
  </section>

  {app.screenshots.length > 0 && (
    <section class="shots-section" aria-label="Screenshots">
      <div class="shots wrap">
        {app.screenshots.map((s) => (
          <img src={s.src} alt={s.alt} width="300" height="650" loading="lazy" decoding="async" />
        ))}
      </div>
    </section>
  )}

  <section class="wrap cta">
    <h2>Get {app.name}</h2>
    <StoreBadges appStore={app.stores.appStore} googlePlay={app.stores.googlePlay} />
    <p class="muted">Questions? <a href="/support">Visit support</a> or email <a href={`mailto:${app.contactEmail}`}>{app.contactEmail}</a>.</p>
  </section>
</Base>

<style>
  /* Navy band with Volt: the brand's loudest look. Volt is text-safe on navy only. */
  .hero { background: var(--band); color: #fff; clip-path: polygon(0 0, 100% 0, 100% calc(100% - 40px), 0 100%); }
  .hero-in { padding: 64px 20px 104px; display: flex; flex-direction: column; align-items: flex-start; }
  .hero h1 { margin: 0 0 28px; }
  .hero h1 img { width: min(420px, 100%); height: auto; }
  .slogan { font-family: var(--font-display); font-weight: 800; font-style: italic; text-transform: uppercase;
    font-size: clamp(3rem, 11vw, 4.5rem); line-height: .95; letter-spacing: -.01em; color: var(--volt); margin: 0 0 20px; }
  .lead { font-size: clamp(1.05rem, 3.2vw, 1.25rem); color: #d5deea; max-width: 34rem; margin: 0 0 32px; }

  .features { display: grid; gap: 16px; grid-template-columns: 1fr; margin-top: 56px; }
  @media (min-width: 720px) { .features { grid-template-columns: repeat(3, 1fr); } }
  .feature { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 24px; }
  .feature-num { font-family: var(--font-mono); font-weight: 700; font-size: 1.6rem; color: var(--accent); margin-bottom: 10px; }
  .feature h2 { font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; line-height: 1.1; margin: 0 0 6px; }
  .feature p { margin: 0; color: var(--muted); }

  .shots-section { margin-top: 64px; }
  .shots { display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 12px; }
  .shots img { flex: 0 0 auto; width: min(240px, 70vw); aspect-ratio: 300 / 650; object-fit: cover;
    border-radius: 24px; border: 1px solid var(--line); scroll-snap-align: start; }
  @media (min-width: 900px) { .shots { justify-content: center; } }

  .cta { text-align: center; margin-top: 72px; display: flex; flex-direction: column; align-items: center; gap: 16px; }
  .cta h2 { font-family: var(--font-display); font-weight: 800; font-style: italic; text-transform: uppercase; font-size: 2.4rem; margin: 0; }
  .cta :global(.badges) { justify-content: center; }
  .muted { color: var(--muted); margin: 0; }
</style>
