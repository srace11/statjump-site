---
// Home page, laid out like a single-scroll product page: hero, video, how it works,
// what it measures, coming soon, about, pricing, FAQ, final call to action.
// Facts come from ~/Documents/statjump-app/README.md. Anything not decided yet is a
// visible placeholder (class "ph"): replace those, don't invent numbers.
import Base from '../layouts/Base.astro';
import { app } from '../app.config';
import ScoringBreakdown from '../components/ScoringBreakdown.astro';

const steps = [
  {
    title: 'Film one approach',
    body: 'A friend holds the phone, or it sits on a tripod, 10 to 15 feet from the side of your approach at head height. Record at 60fps.',
  },
  {
    title: 'Tell it about you',
    body: 'Your height, hitting hand and level. Your height is the ruler: it turns the video into real distances.',
  },
  {
    title: 'Get your scores',
    body: 'Every part of the approach is scored out of 10, plus an overall score, so you know exactly what to work on.',
  },
];

const facts = [
  { title: 'Same video, same score', body: 'Analyze the same clip twice and you get the same result, every time. Progress you see is real progress.' },
  { title: 'All on your phone', body: 'The analysis runs entirely on your device. Your video never leaves your phone.' },
  { title: 'Scored for your level', body: 'Youth to elite. Jump height is judged against your level, while technique is judged the same for everyone.' },
];

const metrics = [
  { name: 'Estimated vertical', body: 'Jump height, from flight time and hip rise.' },
  { name: 'Touch height', body: 'How far you reach above the net.' },
  { name: 'Ground contact time', body: 'How long your final plant takes.' },
  { name: 'Arm swing', body: 'Backswing range and timing, forward swing, bow-and-arrow.' },
  { name: 'Knee bend and load', body: 'Depth, trunk lean and timing of the plant.' },
  { name: 'Penultimate step', body: 'Length, rhythm, hip lowering and a heel-first plant.' },
  { name: 'Approach', body: 'Footwork pattern, speed build-up, and habits like a bunny hop or stutter step.' },
];

const soon = [
  { title: 'Training to jump higher', body: 'Training built from your scores to help you add height.' },
  { title: 'Personal analytics log', body: 'A log of every session, so you can see your progress over time.' },
  { title: 'Team tracking and analysis', body: 'Track and compare analyses across a whole team.' },
];

const faq = [
  {
    q: 'What do I need?',
    a: 'A phone that records at 60fps, and a friend to hold it or a tripod. Film from 10 to 15 feet to the side of your approach, at head height. No sensors, markers or special clothing.',
  },
  {
    q: 'What do I need to tell it about me?',
    a: "Your height, hitting hand, level, and men's or women's norms. Standing reach is optional: skip it and it's estimated from your height.",
  },
  {
    q: 'Does the camera angle matter?',
    a: "Yes, a lot. Film from the side at a right angle to your approach, with the phone held still: from behind or at a slant it can't see your steps or knee bend, and distances come out wrong.",
  },
  {
    q: 'How accurate is it?',
    a: "It hasn't been checked against measured jumps yet, and we're doing that during the beta, so treat the numbers as estimates and watch how they change between your own clips.",
  },
  {
    q: 'Does it replace a coach?',
    a: 'No. It works alongside a coach, showing what changed from one rep to the next.',
  },
  { q: 'Does my video get uploaded anywhere?', a: 'No. Everything runs on your phone, and no video leaves it.' },
  {
    q: 'If I analyze the same video twice, do I get the same score?',
    a: 'Yes. The same video always gets the same score.',
  },
  {
    q: 'Which jumps does it analyze?',
    a: 'One spike approach per video. Block jumps and back-row attacks are not supported yet.',
  },
  {
    q: 'How does it spot a bunny hop or a stutter step?',
    a: 'It tracks every time each foot touches the floor, and flags a bunny hop when both feet land together after a moment in the air before your penultimate step, along with stutter steps, crossover steps and standing starts.',
  },
  {
    q: 'How much does it cost?',
    a: "It's free during the beta. The beta won't last forever, and paid plans will come later.",
  },
  { q: 'Which phones does it work on?', a: 'We plan to release it for both iOS and Android.' },
  { q: 'When does it launch?', a: 'Late fall. Join the waitlist and we will email you once when it is out.' },
];
---
<Base>
  <!-- Hero -->
  <section class="hero">
    <div class="wrap hero-in">
      <p class="eyebrow on-navy">Volleyball approach analysis</p>
      <h1 class="slogan">{app.tagline}</h1>
      <p class="lead">
        Film one spike approach from the side. {app.name} scores every part of it out of 10, so you know exactly what to fix.
      </p>
      <a class="button" href="/waitlist">Join the waitlist</a>
      <p class="note">Free to join. One email when we launch.</p>

    </div>

    <!-- Starts as an inset rounded card and grows to the full page width as you scroll (script below). -->
    <!-- Muted, looping demo. It autoplays unless the viewer prefers reduced motion, and the
         button pauses it (WCAG 2.2.2). It has no sound, so the text description stands in for it (WCAG 1.2.1). -->
    <figure class="video" data-grow>
      <video
        muted
        loop
        playsinline
        controls
        preload="metadata"
        poster="/video/showcase-poster.jpg"
        aria-label="Stat Jump demo: one spike approach, analyzed"
        aria-describedby="showcase-desc"
      >
        <source src="/video/showcase.mp4" type="video/mp4" />
      </video>
      <button class="video-toggle" type="button" hidden>
        <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h4v14H7zM13 5h4v14h-4z" /></svg>
        <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
        <span class="sr-only">Pause video</span>
      </button>
      <figcaption id="showcase-desc" class="sr-only">
        A player runs a spike approach and jumps next to the net while {app.name} tracks their body with a skeleton
        overlay. Labels appear at each moment: approach speed 10.4 mph, penultimate step 0.40 seconds, plant contact
        0.24 seconds, deepest knee bend 119 degrees, vertical 26.8 inches, touch height 10 feet 0 inches, and hang time.
        It ends on the score card: overall 7.8 out of 10, with vertical 7.1, touch height 7.2, ground contact 10.0, arm
        swing 7.8, knee bend 8.7, penultimate step 8.3 and approach 6.3.
      </figcaption>
    </figure>
    <p class="credit">Credit: Donald Hui</p>
  </section>

  <!-- How it works -->
  <section id="how" class="section wrap">
    <p class="eyebrow">How it works</p>
    <h2>Your approach, scored in 3 steps</h2>
    <ol class="steps">
      {steps.map((s, i) => (
        <li class="card">
          <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </li>
      ))}
    </ol>
    <div class="facts">
      {facts.map((f) => (
        <div class="fact">
          <h3>{f.title}</h3>
          <p>{f.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- What it measures -->
  <section id="measures" class="section">
    <div class="wrap head">
      <p class="eyebrow">What it measures</p>
      <h2>Seven scores from one approach</h2>
      <p class="section-lead">Each part is scored out of 10 and rolled into an overall score.</p>
    </div>
    <div class="marquee" role="group" aria-label="The seven scores">
      <div class="track">
        {metrics.map((m) => (
          <div class="card metric">
            <h3>{m.name}</h3>
            <p>{m.body}</p>
          </div>
        ))}
        {metrics.map((m) => (
          <div class="card metric" aria-hidden="true">
            <h3>{m.name}</h3>
            <p>{m.body}</p>
          </div>
        ))}
      </div>
    </div>
    <div class="wrap">
      <ScoringBreakdown />
    </div>
  </section>

  <!-- Coming soon -->
  <section id="soon" class="section wrap">
    <p class="eyebrow">Coming soon</p>
    <h2>What's next</h2>
    <div class="soon">
      {soon.map((f) => (
        <div class="card">
          <h3>{f.title}</h3>
          <p>{f.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Pricing -->
  <section id="pricing" class="section wrap">
    <p class="eyebrow">Pricing</p>
    <h2>Free while we're in beta</h2>
    <div class="plans single">
      <div class="card plan featured">
        <p class="badge-tag">Limited time</p>
        <h3>Beta</h3>
        <p class="price">Free</p>
        <ul>
          <li>Full access to the app</li>
          <li>Nothing to pay during the beta</li>
        </ul>
        <a class="button" href="/waitlist">Join the waitlist</a>
      </div>
    </div>
    <p class="section-lead small">The beta won't last forever, and paid plans will come later.</p>
  </section>

  <!-- FAQ -->
  <section id="faq" class="section wrap narrow">
    <p class="eyebrow">FAQ</p>
    <h2>Questions</h2>
    <div class="faq">
      {faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a ?? <><span class="ph">{f.ph}</span>{f.after}</>}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- About -->
  <section id="about" class="section wrap">
    <p class="eyebrow">About</p>
    <h2>Hi, I'm Shane</h2>
    <div class="about card">
      <img src="/about/shane.jpg" alt="Shane Racey" width="160" height="160" loading="lazy" />
      <div>
        <p>
          I studied operations research at Cornell and pole vaulted for Cornell and Kentucky. Now I work in data
          science and build small, focused apps.
        </p>
        <p>
          I recently got into volleyball since retiring from track and field. I noticed that some rec players struggle
          with the approach and proper jumping. I knew that with my biomechanics and coding background, that I could
          help more people with this tool.
        </p>
        <p>Questions or feedback? Email me at <a href={`mailto:${app.privacyEmail}`}>{app.privacyEmail}</a>.</p>
        <p><a href={app.hubUrl}>More of my apps</a></p>
      </div>
    </div>
  </section>

  <!-- Final call to action -->
  <section class="section wrap final">
    <h2 class="slogan dark">{app.tagline}</h2>
    <p class="section-lead">Be first to score your approach.</p>
    <a class="button" href="/waitlist">Join the waitlist</a>
  </section>
</Base>

<script>
  // Video growth: the width follows how far you've scrolled, from the inset card (p = 0)
  // to the full page width with square corners (p = 1) once the video nears the top.
  const video = document.querySelector<HTMLElement>('[data-grow]');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (video && !still.matches) {
    const hero = video.parentElement!;
    let top0 = 0;
    const measure = () => {
      video.style.removeProperty('--vw');
      top0 = video.getBoundingClientRect().top + window.scrollY;
    };
    const update = () => {
      const full = hero.clientWidth;
      const start = Math.min(860, full - 40);
      const span = Math.max(top0 - 56, 1);
      const p = Math.min(Math.max(window.scrollY / span, 0), 1);
      const e = 1 - Math.pow(1 - p, 2);
      video.style.setProperty('--vw', `${start + (full - start) * e}px`);
      video.style.setProperty('--vr', `${16 * (1 - e)}px`);
      video.style.setProperty('--vb', `${2 * (1 - e)}px`);
    };
    let queued = false;
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => { queued = false; update(); });
    };
    const refresh = () => { measure(); update(); };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', refresh);
    window.addEventListener('load', refresh);
    refresh();
  }

  // Demo video: swap the native controls (the no-JS fallback) for one pause/play button,
  // and only autoplay when the viewer hasn't asked for reduced motion.
  const demo = document.querySelector<HTMLVideoElement>('.video video');
  const toggle = document.querySelector<HTMLButtonElement>('.video-toggle');
  if (demo && toggle) {
    const label = toggle.querySelector('.sr-only')!;
    const sync = () => {
      toggle.classList.toggle('paused', demo.paused);
      label.textContent = demo.paused ? 'Play video' : 'Pause video';
    };
    demo.controls = false;
    toggle.hidden = false;
    demo.addEventListener('play', sync);
    demo.addEventListener('pause', sync);
    toggle.addEventListener('click', () => (demo.paused ? demo.play() : demo.pause()));
    sync();
    if (!still.matches) demo.play().catch(sync);
  }
</script>

<style>
  /* Placeholders: visible on purpose, so nothing unfinished passes as real. */
  .ph { font-style: italic; color: var(--muted); }
  .ph-frame { border: 2px dashed var(--line); }

  .eyebrow { font-size: .78rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase;
    color: var(--accent); margin: 0 0 10px; text-align: center; }
  .eyebrow.on-navy { color: var(--volt); }

  .button { display: inline-flex; align-items: center; justify-content: center; min-height: 52px; padding: 12px 28px;
    background: var(--volt); color: var(--on-volt); border: 2px solid var(--volt); border-radius: var(--radius);
    font-weight: 600; font-size: 1.05rem; text-decoration: none; }
  .button:hover { filter: brightness(1.06); }
  .button:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  .button.outline { background: transparent; color: var(--fg); border-color: var(--line); }

  /* Hero: navy band, centred, one loud line. Volt is text-safe on navy only. */
  .hero { background: var(--band); color: #fff; padding-bottom: 64px; }
  .hero-in { padding: 72px 20px 0; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .slogan { font-family: var(--font-display); font-weight: 800; font-style: italic; text-transform: uppercase;
    font-size: clamp(3.2rem, 12vw, 6rem); line-height: .92; letter-spacing: -.01em; color: var(--volt); margin: 0 0 22px; }
  .lead { font-size: clamp(1.08rem, 3.2vw, 1.3rem); color: #d5deea; max-width: 36rem; margin: 0 0 30px; }
  .hero .button:focus-visible { outline-color: #fff; }
  .note { font-size: .9rem; color: #a9b6cc; margin: 12px 0 0; }
  .video { position: relative; overflow: hidden; width: var(--vw, min(860px, calc(100% - 40px))); max-height: 88vh;
    aspect-ratio: 16 / 9; margin: 48px auto 0; border-radius: var(--vr, 16px);
    border: var(--vb, 2px) solid rgba(255, 255, 255, .25); background: var(--navy); }
  /* contain, not cover: when max-height kicks in, cover would crop the score card text. */
  .credit { margin: 8px 0 0; text-align: center; font-size: .72rem; color: #a9b6cc; }
  .video video { display: block; width: 100%; height: 100%; object-fit: contain; }
  /* Small on purpose, but 24px is the smallest tap target WCAG 2.5.8 allows. */
  .video-toggle { position: absolute; right: 10px; bottom: 10px; width: 24px; height: 24px; border-radius: 4px;
    display: grid; place-items: center; padding: 0; cursor: pointer;
    background: rgba(11, 27, 51, .6); color: #fff; border: 0; }
  .video-toggle[hidden] { display: none; }
  .video-toggle svg { width: 14px; height: 14px; fill: currentColor; }
  .video-toggle:hover { background: var(--navy); }
  .video-toggle:focus-visible { outline: 3px solid var(--volt); outline-offset: 3px; }
  .video-toggle .i-play, .video-toggle.paused .i-pause { display: none; }
  .video-toggle.paused .i-play { display: block; }

  /* Sections: small label, big centred heading, content. */
  .section { padding-top: 96px; }
  .section > h2, .head > h2 { font-family: var(--font-display); font-weight: 700; text-align: center;
    font-size: clamp(2.2rem, 6vw, 3rem); line-height: 1.05; margin: 0 0 14px; }
  .section-lead { text-align: center; color: var(--muted); max-width: 36rem; margin: 0 auto 36px; font-size: 1.05rem; }
  .section-lead.small { margin: 20px auto 0; font-size: .95rem; }
  .section > h2 + :not(.section-lead), .head > h2 + :not(.section-lead) { margin-top: 36px; }
  .narrow { max-width: 760px; }

  .card { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 24px; }
  .card h3 { font-family: var(--font-display); font-weight: 700; font-size: 1.45rem; line-height: 1.1; margin: 0 0 6px; }
  .card p { margin: 0; color: var(--muted); }

  .steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 16px; }
  @media (min-width: 760px) { .steps { grid-template-columns: repeat(3, 1fr); } }
  .num { display: block; font-family: var(--font-mono); font-weight: 700; font-size: 1.6rem; color: var(--accent); margin-bottom: 10px; }

  .facts { display: grid; gap: 16px; margin-top: 16px; }
  @media (min-width: 760px) { .facts { grid-template-columns: repeat(3, 1fr); } }
  .fact { border-top: 3px solid var(--volt); padding: 18px 4px 0; }
  .fact h3 { font-size: 1.05rem; margin: 0 0 4px; }
  .fact p { margin: 0; color: var(--muted); }

  /* One row of cards drifting sideways, endlessly. The set is repeated twice, so moving
     the track left by half its width loops with no jump. Pauses on hover and focus. */
  .marquee { overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
  .track { display: flex; gap: 16px; width: max-content; animation: drift 60s linear infinite; }
  .marquee:hover .track, .marquee:focus-within .track { animation-play-state: paused; }
  @keyframes drift { to { transform: translateX(calc(-50% - 8px)); } }
  .metric { flex: none; width: 290px; padding: 20px; }
  .metric h3 { font-size: 1.25rem; }
  @media (prefers-reduced-motion: reduce) {
    /* Wrap into rows instead of a sideways scroller, so nothing is out of keyboard reach. */
    .marquee { overflow: visible; -webkit-mask-image: none; mask-image: none; }
    .track { animation: none; width: auto; max-width: var(--maxw); margin: 0 auto; padding: 0 20px;
      flex-wrap: wrap; justify-content: center; }
    .metric[aria-hidden='true'] { display: none; }
  }

  .soon { display: grid; gap: 16px; }
  @media (min-width: 760px) { .soon { grid-template-columns: repeat(3, 1fr); } }
  .soon .card { background: transparent; }

  .about { display: grid; gap: 24px; align-items: center; max-width: 760px; margin: 0 auto; }
  @media (min-width: 640px) { .about { grid-template-columns: 160px 1fr; } }
  .about img { width: 160px; height: 160px; border-radius: 50%; object-fit: cover; }
  .about p { color: var(--fg); margin: 0 0 12px; }
  .about p:last-child { margin: 0; }
  .about p.ph { color: var(--muted); }

  .plans { display: grid; gap: 16px; max-width: 420px; margin: 0 auto; }
  .plan { display: flex; flex-direction: column; gap: 14px; }
  .plan { position: relative; }
  .plan.featured { border: 2px solid var(--volt); }
  .card .badge-tag { position: absolute; top: -13px; left: 20px; margin: 0; background: var(--volt); color: var(--on-volt);
    font-size: .75rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; padding: 3px 10px; border-radius: 999px; }
  .card .price { font-family: var(--font-mono); font-weight: 700; font-size: 1.8rem; margin: 0; color: var(--fg); }
  .plan ul { margin: 0; padding-left: 20px; flex: 1; }
  .plan li { margin: 4px 0; }

  .faq { display: grid; gap: 10px; }
  details { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 0 20px; }
  summary { cursor: pointer; font-weight: 600; padding: 16px 0; }
  summary::marker { color: var(--accent); }
  details p { margin: 0 0 16px; color: var(--muted); }

  .final { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .slogan.dark { color: var(--fg); font-size: clamp(2.8rem, 10vw, 4.5rem); }
</style>
