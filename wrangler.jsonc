{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "statjump-site",
  "compatibility_date": "2026-09-01",
  // Builds the Astro site before every deploy, then serves dist/ as static files.
  "build": { "command": "npm run build" },
  // Redirects old addresses and short links (see worker/index.js); everything else is served from dist/.
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  // Attaches the domains and creates their DNS records on deploy. statjump.app is the site; the
  // rest only redirect to it (www, and the old shaneracey.com subdomains that earlier links point at).
  "routes": [
    { "pattern": "statjump.app", "custom_domain": true },
    { "pattern": "www.statjump.app", "custom_domain": true },
    { "pattern": "statjump.shaneracey.com", "custom_domain": true },
    { "pattern": "volleyball.shaneracey.com", "custom_domain": true }
  ]
}
