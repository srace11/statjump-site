{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "statjump-site",
  "compatibility_date": "2026-09-01",
  // Builds the Astro site before every deploy, then serves dist/ as static files.
  "build": { "command": "npm run build" },
  // Only redirects the old address; everything else is served from dist/.
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  // Attaches the subdomains and creates their DNS records on deploy.
  "routes": [
    { "pattern": "statjump.shaneracey.com", "custom_domain": true },
    { "pattern": "volleyball.shaneracey.com", "custom_domain": true }
  ]
}
